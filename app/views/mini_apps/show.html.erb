<%= content_for :page_title, @mini_app.name %>

<div class="space-y-4 pb-6"
     data-controller="mini-app-host"
     data-mini-app-host-bridge-url-value="<%= bridge_mini_app_path(@mini_app) %>">
  <header class="flex items-center gap-3 flex-wrap">
    <div class="flex items-center justify-center w-10 h-10 rounded-lg bg-container-inset shrink-0">
      <%= icon(@mini_app.icon.presence || "blocks", size: "md") %>
    </div>
    <div class="flex items-center gap-2 min-w-0 grow">
      <h1 class="text-2xl font-semibold text-primary truncate"><%= @mini_app.name %></h1>
      <%= render DS::Pill.new(label: t("shared.preview"), size: :md) %>
    </div>
    <div class="flex items-center gap-2">
      <%= render DS::Link.new(text: t(".back"), href: mini_apps_path, variant: "ghost", icon: "arrow-left") %>
      <% if Current.user.admin? %>
        <%= render DS::Link.new(text: t(".manage"), href: consent_mini_app_path(@mini_app), variant: "outline", icon: "shield-check") %>
        <%= render DS::Link.new(text: t(".activity"), href: activity_mini_app_path(@mini_app), variant: "outline", icon: "list") %>
      <% end %>
    </div>
  </header>

  <% if @mini_app.dev_server? %>
    <%= render DS::Alert.new(title: t(".dev_server_title"), message: t(".dev_server_warning", url: @mini_app.dev_url), variant: :warning) %>
  <% end %>

  <%= tag.iframe src: @frame_src,
        title: t(".frame_title", name: @mini_app.name),
        sandbox: "allow-scripts allow-forms allow-popups",
        referrerpolicy: "no-referrer",
        class: "block w-full h-160 rounded-xl bg-container shadow-border-xs",
        data: { mini_app_host_target: "frame" } %>

  <%# Drawn by Sure outside the frame, so the app can neither fake nor click it. %>
  <dialog class="m-auto w-full max-w-md rounded-xl bg-container text-primary shadow-border-xs p-0 backdrop:bg-overlay"
          aria-labelledby="mini-app-confirm-title"
          data-mini-app-host-target="confirmDialog">
    <div class="p-4 space-y-3">
      <div class="flex items-center gap-2">
        <%= icon("shield-alert", color: "warning") %>
        <h2 id="mini-app-confirm-title" class="font-medium text-primary"><%= t(".confirm_title") %></h2>
      </div>
      <p class="text-sm text-secondary"><%= t(".confirm_intro", name: @mini_app.name) %></p>
      <p class="text-sm text-primary font-medium bg-container-inset rounded-lg p-3 break-words" data-mini-app-host-target="confirmMessage"></p>
      <%# Filled from the server's description of the call's actual arguments. %>
      <dl class="hidden space-y-1 text-sm" aria-label="<%= t(".confirm_details") %>" data-mini-app-host-target="confirmDetails"></dl>
      <template data-mini-app-host-target="confirmDetailRow">
        <div class="flex gap-3">
          <dt class="w-1/3 shrink-0 text-secondary break-words"></dt>
          <dd class="min-w-0 grow text-primary break-words"></dd>
        </div>
      </template>
      <p class="text-xs text-secondary"><%= t(".confirm_hint") %></p>
    </div>
    <div class="flex items-center justify-end gap-2 p-4 pt-0">
      <%= render DS::Button.new(text: t(".decline"), variant: "outline", autofocus: true, data: { action: "mini-app-host#decline", mini_app_host_target: "declineButton" }) %>
      <%= render DS::Button.new(text: t(".approve"), variant: "primary", disabled: true, data: { action: "mini-app-host#approve", mini_app_host_target: "approveButton" }) %>
    </div>
  </dialog>
</div>
