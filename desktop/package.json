{
  "name": "sure-desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "tauri": "tauri",
    "runtime:mac": "scripts/build-runtime-macos.sh",
    "runtime:app": "scripts/build-runtime-macos.sh --app-only",
    "dev:local": "SURE_RUNTIME_DIR=\"$PWD/runtime\" tauri dev",
    "build:mac": "tauri build --config src-tauri/tauri.local.conf.json",
    "build:app": "tauri build --config src-tauri/tauri.local.conf.json --bundles app",
    "test:rust": "cd src-tauri && cargo test",
    "test:smoke": "cd src-tauri && SURE_RUNTIME_DIR=\"$PWD/../runtime\" cargo test --test packaged_runtime_test -- --nocapture",
    "seed:dev": "scripts/local-rails.sh --dev desktop:dev_seed"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.1.0",
    "typescript": "^5.6.0",
    "vite": "^6.4.5"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.1.0",
    "@tauri-apps/plugin-notification": "^2.0.0",
    "@tauri-apps/plugin-autostart": "^2.0.0",
    "@tauri-apps/plugin-deep-link": "^2.0.0"
  }
}
